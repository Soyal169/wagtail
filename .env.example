# Copy this file to .env and fill in real values for local development.

# Django
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
WAGTAILADMIN_BASE_URL=http://localhost:8000

# Database (defaults to local sqlite3 file when unset)
# DATABASE_URL=postgres://user:password@localhost:5432/soyal_portfolio

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@soyal-portfolio.dev
CONTACT_RECIPIENT_EMAIL=soyal@example.com
